def feeds_path_from(cfg: dict[str, str], config_dir: Path) -> Path:
    raw = cfg.get("feeds_file", "").strip()
    if not raw:
        return config_dir / "feeds"
    return Path(expand(raw))


# --- small text helpers -----------------------------------------------------


def one_line(text: str, limit: int = 160) -> str:
    cleaned = " ".join((text or "").split())
    if len(cleaned) > limit:
        return cleaned[: limit - 1] + "…"
    return cleaned


# Phone downloads (Grayjay and others) rewrite names: emoji and punctuation
# disappear or become underscores, and long names are cut off. Matching uses
# letters and digits only. A filename that shares a long opening with the
# title is treated as the same recording.
MIN_MATCH = 12
MIN_TRUNCATED = 20
AUDIO_EXTENSIONS = {".opus", ".ogg", ".m4a", ".mp3", ".aac", ".flac", ".mka", ".wav"}


def strip_id_suffix(stem: str) -> str:
    """Drop a trailing ' [videoId]' added by the output template."""
    if not stem.endswith("]") or " [" not in stem:
        return stem
    head, _, tail = stem.rpartition(" [")
    inner = tail[:-1]
    if len(inner) >= 6 and all(ch.isalnum() or ch in "-_" for ch in inner):
        return head
    return stem


def squash(text: str) -> str:
    """Letters and digits only. Apostrophes are removed so I'm and I_m agree."""
    folded = unicodedata.normalize("NFKD", text or "").casefold()
    for mark in ("'", "’", "ʼ", "`", "´"):
        folded = folded.replace(mark, "")
    chars = []
    for ch in folded:
        if unicodedata.combining(ch):
            continue
        if ch.isalnum():
            chars.append(ch)
    return "".join(chars)


def is_sequel_suffix(extra: str) -> bool:
    """True for a trailing copy number, not for the rest of a shortened title."""
    if extra.isdigit() and len(extra) <= 4:
        return True
    for prefix in ("part", "pt", "ep", "episode", "vol", "volume"):
        if extra.startswith(prefix) and extra[len(prefix):].isdigit() and len(extra) - len(prefix) <= 3:
            return True
    return False


# Characters Grayjay keeps in a download name. Everything else becomes '_'
# or, for emoji, disappears. The result matches files already in the folder.
GRAYJAY_KEEP = set("-_.+")


def grayjay_stem(title: str) -> str:
    """Filename stem Grayjay writes for a video title."""
    text = unicodedata.normalize("NFC", title or "")
    chars: list[str] = []
    for char in text:
        if char.isalnum() or char in GRAYJAY_KEEP:
            chars.append(char)
            continue
        category = unicodedata.category(char)
        if category.startswith("C") or category in {"So", "Sk", "Mn", "Mc", "Me"}:
            continue
        chars.append("_")
    stem = "".join(chars)
    while "__" in stem:
        stem = stem.replace("__", "_")
    stem = stem.strip("_").rstrip(".")
    stem = stem.strip("_")
    raw = stem.encode("utf-8")
    if len(raw) > 240:
        stem = raw[:240].decode("utf-8", "ignore").strip("_.")
    return stem


def place_like_grayjay(path: Path, title: str) -> Path:
    """Rename a finished file to the title-only name Grayjay uses.

    A file already at that name is left in place. The new copy is removed.
    """
    if not path.is_file() or title.startswith(("http://", "https://")):
        return path
    stem = grayjay_stem(title)
    if not stem:
        return path
    target = path.with_name(stem + path.suffix)
    if target == path:
        return path
    if target.exists():
        path.unlink()
        return target
    path.rename(target)
    return target


def is_quality_suffix(extra: str) -> bool:
    return extra in {
        "1080", "1080p", "720", "720p", "480", "480p", "360", "360p",
        "2160", "2160p", "4k", "hd", "sd", "opus", "mp3", "m4a", "audio",
    }


def file_matches(title_key: str, file_key: str) -> bool:
    """True when a stored filename is this title, or a shortened form of it."""
    if len(title_key) < MIN_MATCH or len(file_key) < MIN_MATCH:
        return False
    if title_key == file_key:
        return True
    # The file was cut off: it is a long opening of the full title.
    if len(file_key) >= MIN_TRUNCATED and title_key.startswith(file_key):
        return not is_sequel_suffix(title_key[len(file_key):])
    # The file kept a short quality tag after the title.
    if len(title_key) >= MIN_TRUNCATED and file_key.startswith(title_key):
        extra = file_key[len(title_key):]
        return is_quality_suffix(extra) and not is_sequel_suffix(extra)
    return False


class SeenTitles:
    """Titles already saved, plus filenames already sitting in the output folder."""

    def __init__(self) -> None:
        self.exact: set[str] = set()
        self.files: list[str] = []

    def add_title(self, title: str) -> None:
        key = squash(title)
        if len(key) >= MIN_MATCH:
            self.exact.add(key)

    def add_stem(self, stem: str) -> None:
        cleaned = strip_id_suffix(stem)
        forms = [cleaned]
        # "Channel - Title" keeps the title as its own name, so a short title
        # still matches after the channel prefix is removed.
        if " - " in cleaned:
            forms.append(cleaned.split(" - ", 1)[-1])
        for form in forms:
            key = squash(form)
            if len(key) >= MIN_MATCH and key not in self.files:
                self.files.append(key)

    def reason(self, title: str) -> str:
        key = squash(title)
        if len(key) < MIN_MATCH:
            return ""
        if any(file_matches(key, file_key) for file_key in self.files):
            return "matching audio already in the output folder"
        if key in self.exact:
            return "same title already saved"
        return ""


def load_seen(state: dict, output_dir: Path) -> SeenTitles:
    seen = SeenTitles()
    for item in state.get("items", {}).values():
        if item.get("status") != "downloaded":
            continue
        seen.add_title(str(item.get("title") or ""))
        saved = str(item.get("path") or "")
        if saved:
            seen.add_stem(Path(saved).stem)
    if output_dir.exists():
        for path in output_dir.rglob("*"):
            if not path.is_file() or path.name.startswith("."):
                continue
            if path.suffix.lower() in AUDIO_EXTENSIONS:
                seen.add_stem(path.stem)
    return seen


def label(entry: Entry) -> str:
    name = one_line(entry.feed_name, 40) or "feed"
    title = one_line(entry.title, 100) or entry.url
    return f"{name} — {title}"


def pretty(path: str) -> str:
    if not path:
        return ""
    try:
        resolved = Path(path).expanduser()
        home = Path.home()
        if resolved.is_relative_to(home):
            return "~/" + str(resolved.relative_to(home))
    except (OSError, ValueError):
        return path
    return path


def parse_date(value: str) -> datetime | None:
    text = (value or "").strip()
    if not text:
        return None
    try:
        parsed = datetime.fromisoformat(text.replace("Z", "+00:00"))
    except ValueError:
        parsed = None
    if parsed is None:
        try:
            parsed = email.utils.parsedate_to_datetime(text)
        except (TypeError, ValueError, IndexError, OverflowError):
            return None
    if parsed is None:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed.astimezone(timezone.utc)


def local_name(tag: object) -> str:
    if not isinstance(tag, str):
        return ""
    return tag.rsplit("}", 1)[-1]


def children(node: ET.Element, name: str) -> list[ET.Element]:
    return [child for child in list(node) if local_name(child.tag) == name]


def child_text(node: ET.Element, name: str) -> str:
    for child in children(node, name):
        if child.text and child.text.strip():
            return child.text.strip()
    return ""


def link_of(node: ET.Element) -> str:
    alternate = ""
    any_href = ""
    text_url = ""
    for link in children(node, "link"):
        href = (link.get("href") or "").strip()
        rel = link.get("rel")
        if href and rel == "alternate" and not alternate:
            alternate = href
        if href and not any_href:
            any_href = href
        text = (link.text or "").strip()
        if text.startswith("http") and not text_url:
            text_url = text
    return alternate or text_url or any_href


def author_of(node: ET.Element, fallback: str) -> str:
    for author in children(node, "author"):
        name = child_text(author, "name")
        if name:
            return name
    creator = child_text(node, "creator")
    return creator or fallback


def feed_author(node: ET.Element) -> str:
    for author in children(node, "author"):
        name = child_text(author, "name")
        if name:
            return name
    return child_text(node, "title")


def entry_date(node: ET.Element) -> datetime | None:
    for key in ("published", "updated", "pubDate", "date"):
        found = parse_date(child_text(node, key))
        if found is not None:
            return found
    return None


def youtube_id(url: str) -> str:
    parsed = urllib.parse.urlparse(url)
    host = parsed.netloc.lower().removeprefix("www.").removeprefix("m.")
    if host in {"youtube.com", "music.youtube.com"}:
        query = urllib.parse.parse_qs(parsed.query)
        video = query.get("v", [""])[0]
        if video:
            return f"yt:{video}"
    if host == "youtu.be":
        video = parsed.path.strip("/").split("/")[0]
        if video:
            return f"yt:{video}"
    return ""


# --- feed list and feed documents ------------------------------------------


def parse_feed_line(line: str) -> Feed | None:
    raw = line.strip()
    if not raw or raw.startswith("#"):
        return None
    try:
        parts = shlex.split(raw, posix=True)
    except ValueError:
        return None
    if not parts or not parts[0].startswith(("http://", "https://")):
        return None
    name = parts[1] if len(parts) > 1 else ""
    return Feed(parts[0], name, tuple(parts[2:]))


def load_feeds(path: Path, require_tag: str) -> list[Feed]:
    if not path.exists():
        raise SystemExit(f"no feed list at {path}. Run: feedopus init")
    seen: set[str] = set()
    feeds: list[Feed] = []
    for line in path.read_text(encoding="utf-8").splitlines():
        feed = parse_feed_line(line)
        if feed is None or feed.url in seen:
            continue
        if require_tag and require_tag not in feed.tags:
            continue
        seen.add(feed.url)
        feeds.append(feed)
    return feeds


def looks_like_feed(url: str) -> bool:
    parsed = urllib.parse.urlparse(url)
    blob = (parsed.path + "?" + parsed.query).lower()
    return any(bit in blob for bit in ("/feed", "rss", ".xml", "atom"))


def import_newsboat(urls_path: Path) -> list[str]:
    if not urls_path.exists():
        return []
    chosen = []
    for line in urls_path.read_text(encoding="utf-8").splitlines():
        feed = parse_feed_line(line)
        if feed is None:
            continue
        haystack = feed.url.lower()
        if any(marker in haystack for marker in IMPORT_MARKERS):
            chosen.append(line.strip())
    return chosen


def fetch_bytes(url: str) -> bytes:
    last: Exception | None = None
    for attempt in (1, 2):
        try:
            request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
            with urllib.request.urlopen(request, timeout=30) as response:
                data = response.read(MAX_FEED_BYTES + 1)
            if len(data) > MAX_FEED_BYTES:
                raise RuntimeError("feed is larger than 8MB")
            return data
        except (urllib.error.URLError, TimeoutError, OSError, RuntimeError) as exc:
            last = exc
            if attempt == 1:
                time.sleep(3)
    assert last is not None
    raise last


def parse_feed_xml(data: bytes, feed: Feed) -> list[Entry]:
    if data.startswith(b"\xef\xbb\xbf"):
        data = data[3:]
    root = ET.fromstring(data)
    tag = local_name(root.tag)
    if tag == "feed":
        channel = root
        nodes = children(root, "entry")
        fallback_author = feed_author(root)
        channel_title = child_text(root, "title")
    elif tag == "rss":
        channels = children(root, "channel")
        channel = channels[0] if channels else root
        nodes = children(channel, "item")
        fallback_author = feed_author(channel)
        channel_title = child_text(channel, "title")
    else:
        raise ValueError(f"unknown feed type <{tag}>")
    display = feed.name or channel_title or fallback_author or urllib.parse.urlparse(feed.url).netloc
    entries: list[Entry] = []
    seen: set[str] = set()
    for node in nodes:
        video = child_text(node, "videoId")
        url = link_of(node)
        if not url:
            for enclosure in children(node, "enclosure"):
                enclosed = (enclosure.get("url") or "").strip()
                if enclosed:
                    url = enclosed
                    break
        guid = child_text(node, "guid") or child_text(node, "id")
        if video:
            url = f"https://www.youtube.com/watch?v={video}"
            entry_id = f"yt:{video}"
        else:
            entry_id = youtube_id(url) or guid or url
        if not url or not entry_id or entry_id in seen:
            continue
        title = child_text(node, "title")
        if not title:
            for group in children(node, "group"):
                title = child_text(group, "title")
                if title:
                    break
        author = author_of(node, fallback_author or display)
        entries.append(
            Entry(
                id=entry_id,
                url=url,
                title=title or url,
                author=author,
                published=entry_date(node),
                feed_url=feed.url,
                feed_name=display,
            )
        )
        seen.add(entry_id)
    return entries


def youtube_listing_url(url: str) -> str | None:
    """Uploads playlist for a YouTube Atom feed, used when RSS fails.

    A channel id UCxxxx uses playlist UUxxxx. Other sites return None and
    keep their own RSS.
    """
    parsed = urllib.parse.urlparse(url)
    host = parsed.netloc.lower().removeprefix("www.").removeprefix("m.")
    if host not in {"youtube.com", "music.youtube.com"}:
        return None
    if "feeds/videos.xml" not in parsed.path:
        return None
    query = urllib.parse.parse_qs(parsed.query)
    channel_id = (query.get("channel_id") or [""])[0].strip()
    playlist_id = (query.get("playlist_id") or [""])[0].strip()
    user = (query.get("user") or [""])[0].strip()
    if channel_id.startswith("UC") and len(channel_id) > 2:
        playlist_id = "UU" + channel_id[2:]
    elif channel_id:
        return f"https://www.youtube.com/channel/{urllib.parse.quote(channel_id)}/videos"
    if playlist_id:
        return "https://www.youtube.com/playlist?list=" + urllib.parse.quote(playlist_id)
    if user:
        return f"https://www.youtube.com/user/{urllib.parse.quote(user)}/videos"
    return None


def fetch_subscription(
    feed: Feed,
    playlist_end: int,
    cookies: str,
    page_url: str = "",
    browser: str = "",
) -> list[Entry]:
    target = page_url or feed.url
    cmd = [
        "yt-dlp",
        "--flat-playlist",
        "--playlist-end",
        str(playlist_end),
        "--no-warnings",
        "--ignore-errors",
        "--print",
        "%(id)s\t%(webpage_url)s\t%(title)s\t%(channel)s\t%(timestamp)s",
        target,
    ]
    host = urllib.parse.urlparse(target).netloc.lower()
    if "youtube" in host or host.endswith("youtu.be"):
        # Flat playlists omit dates unless this is set. The date is approximate.
        cmd[1:1] = ["--extractor-args", "youtubetab:approximate_date"]
    auth = yt_auth_args(cookies, browser)
    if auth:
        cmd[1:1] = auth
    result = run_cmd(cmd, PROBE_TIMEOUT)
    if result.code != 0 and not result.out.strip():
        detail = one_line(result.err or result.out) or f"yt-dlp exited {result.code}"
        raise RuntimeError(detail)
    display = feed.name or urllib.parse.urlparse(feed.url).netloc
    entries: list[Entry] = []
    seen: set[str] = set()
    for raw in result.out.splitlines():
        parts = raw.split("\t")
        if len(parts) < 3:
            continue
        video, page, title, channel, stamp = (parts + ["", "", "", "", ""])[:5]
        if not page or page == "NA":
            if video and video != "NA":
                page = f"https://www.youtube.com/watch?v={video}"
            else:
                continue
        if video and video != "NA" and ("youtube" in feed.url or youtube_id(page)):
            entry_id = f"yt:{video}"
        elif video and video != "NA":
            entry_id = video
        else:
            entry_id = page
        if entry_id in seen:
            continue
        published = None
        if stamp.isdigit():
            published = datetime.fromtimestamp(int(stamp), timezone.utc)
        name = feed.name or (channel if channel and channel != "NA" else display)
        entries.append(
            Entry(
                id=entry_id,
                url=page,
                title=title if title and title != "NA" else page,
                author=channel if channel and channel != "NA" else name,
                published=published,
                feed_url=feed.url,
                feed_name=name,
            )
        )
        seen.add(entry_id)
    return entries


def fetch_feed(feed: Feed, playlist_end: int, cookies: str, browser: str = "") -> list[Entry]:
    listing = youtube_listing_url(feed.url)
    if listing or looks_like_feed(feed.url):
        try:
            data = fetch_bytes(feed.url)
            return parse_feed_xml(data, feed)
        except (urllib.error.URLError, TimeoutError, OSError, RuntimeError, ET.ParseError, ValueError) as exc:
            if not listing:
                raise
            log(f"rss       {feed.name or feed.url} ({one_line(str(exc))}; checking the uploads playlist)")
            return fetch_subscription(feed, playlist_end, cookies, listing, browser)
    return fetch_subscription(feed, playlist_end, cookies, browser=browser)


# --- planning ---------------------------------------------------------------


def sort_entries(entries: list[Entry]) -> list[Entry]:
    """Oldest first. Entries with no date stay in feed order, after the dated ones."""
    dated = [entry for entry in entries if entry.published is not None]
    undated = [entry for entry in entries if entry.published is None]
    dated.sort(key=lambda entry: entry.published.timestamp())
    return dated + undated


def select_action(
    prev: dict | None,
    published: datetime | None,
    feed_bootstrapped: bool,
    window: int | None,
    now: datetime,
    retry: bool,
) -> str:
    """Return queue, seen, or ignore.

    window is None when the feed was already read and the user did not pass
    --since-days. In that case every unseen item is new.
    """
    if prev:
        status = prev.get("status")
        if status == "deferred":
            return "queue"
        if status == "error" and (retry or int(prev.get("tries") or 0) < 3):
            return "queue"
        return "ignore"
    if window is None and feed_bootstrapped:
        return "queue"
    if published is None:
        return "seen"
    days = 2 if window is None else window
    cutoff = now - timedelta(days=days)
    if published >= cutoff:
        return "queue"
    return "seen"


def plan_feed(
    entries: list[Entry],
    items: dict,
    feed_bootstrapped: bool,
    since_days: int,
    since_days_explicit: bool,
    backfill: int | None,
    retry: bool,
    now: datetime,
) -> list[tuple]:
    """Return ('queue', entry) or ('seen', entry, detail). Queued entries are oldest first."""
    oldest_first = sort_entries(entries)
    actions: list[tuple] = []
    if backfill is not None:
        # Pick the newest unsaved items, then save that selection from oldest to newest.
        dated = [entry for entry in oldest_first if entry.published is not None]
        undated = [entry for entry in oldest_first if entry.published is None]
        taken = 0
        queued: list[Entry] = []
        for entry in list(reversed(dated)) + undated:
            prev = items.get(entry.id)
            if prev and prev.get("status") in {"downloaded", "skipped"}:
                continue
            if taken < backfill:
                queued.append(entry)
                taken += 1
            elif prev is None:
                actions.append(("seen", entry, f"outside backfill of {backfill}"))
        actions.extend(("queue", entry) for entry in sort_entries(queued))
        return actions

    window: int | None
    if since_days_explicit or not feed_bootstrapped:
        window = since_days
    else:
        window = None

    for entry in oldest_first:
        choice = select_action(items.get(entry.id), entry.published, feed_bootstrapped, window, now, retry)
        if choice == "queue":
            actions.append(("queue", entry))
        elif choice == "seen":
            if entry.published is None:
                detail = "undated on first fetch"
            else:
                detail = f"older than {window} days"
            actions.append(("seen", entry, detail))
    return actions


def classify(live_status: str, was_live: str, is_live: str, skip_live: bool, skip_was_live: bool) -> str:
    """Return download, skip, or defer."""
    if not skip_live:
        return "download"
    status = (live_status or "").strip().lower()
    was = (was_live or "").strip().lower() in {"true", "1", "yes"}
    live = (is_live or "").strip().lower() in {"true", "1", "yes"}
    if status == "was_live" or was:
        return "skip" if skip_was_live else "download"
    if live or status in {"is_live", "is_upcoming", "post_live"}:
        return "defer"
    return "download"


def live_is_stale(entry: Entry, prev: dict | None, now: datetime, days: int) -> bool:
    started = entry.published
    if started is None and prev and prev.get("first_seen"):
        started = parse_date(str(prev.get("first_seen")))
    if started is None:
        return False
    return now - started > timedelta(days=days)


def round_robin(groups: list[list[Entry]]) -> list[Entry]:
    """Take turns across feeds. Each group is already oldest first, and that order is kept."""
    queues = [deque(group) for group in groups if group]
    ordered: list[Entry] = []
    while queues:
        remaining = []
        for queue in queues:
            ordered.append(queue.popleft())
            if queue:
                remaining.append(queue)
        queues = remaining
    return ordered


# --- state ------------------------------------------------------------------


def empty_state() -> dict:
    return {"version": 1, "feeds": {}, "items": {}}


def load_state(path: Path) -> dict:
    if not path.exists():
        return empty_state()
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        broken = path.with_name(path.name + ".broken")
        os.replace(path, broken)
        log(f"state file was unreadable ({exc}); moved it to {pretty(str(broken))}")
        return empty_state()
    if not isinstance(data, dict):
        return empty_state()
    data.setdefault("version", 1)
    data.setdefault("feeds", {})
    data.setdefault("items", {})
    return data


def save_state(path: Path, state: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(".json.tmp")
    temporary.write_text(json.dumps(state, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    os.replace(temporary, path)


def record(state: dict, entry: Entry, result: Result, prev: dict | None, now: datetime) -> None:
    stamp = now.isoformat()
    if result.status == "error":
        if prev and prev.get("status") == "error":
            tries = int(prev.get("tries") or 0) + 1
        else:
            tries = 1
    else:
        tries = 0
    first_seen = stamp
    if prev and prev.get("first_seen"):
        first_seen = str(prev["first_seen"])
    state["items"][entry.id] = {
        "id": entry.id,
        "url": entry.url,
        "title": entry.title,
        "author": entry.author,
        "feed": entry.feed_name,
        "published": entry.published.isoformat() if entry.published else "",
        "status": result.status,
        "detail": result.detail,
        "path": result.path,
        "updated": stamp,
        "tries": tries,
        "first_seen": first_seen,
    }


# --- yt-dlp -----------------------------------------------------------------


def run_cmd(cmd: list[str], timeout: int) -> CmdResult:
    proc = subprocess.Popen(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        encoding="utf-8",
        errors="replace",
        start_new_session=True,
    )
    try:
        out, err = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        stop_process_group(proc)
        out, err = proc.communicate()
        err = (err or "") + "\ntimed out"
        return CmdResult(124, out or "", err)
    return CmdResult(proc.returncode or 0, out or "", err or "")


def stop_process_group(proc: subprocess.Popen) -> None:
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    try:
        proc.wait(timeout=10)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        proc.wait(timeout=10)


def require_tools() -> None:
    missing = [name for name in ("yt-dlp", "ffmpeg") if shutil.which(name) is None]
    if missing:
        raise SystemExit(
            "missing required program: "
            + ", ".join(missing)
            + ". Install yt-dlp and an ffmpeg build with libopus."
        )
    proc = subprocess.run(
        ["ffmpeg", "-hide_banner", "-encoders"],
        capture_output=True,
        text=True,
        check=False,
    )
    if "libopus" not in (proc.stdout or ""):
        raise SystemExit("ffmpeg has no libopus encoder, so Opus files cannot be written")


def probe_live(url: str, cookies: str, browser: str = "") -> tuple[str, str, str] | Result:
    cmd = [
        "yt-dlp",
        "--skip-download",
        "--no-warnings",
        "--no-playlist",
        "--print",
        "%(live_status)s\t%(was_live)s\t%(is_live)s",
    ]
    cmd += yt_auth_args(cookies, browser)
    cmd.append(url)
    result = run_cmd(cmd, PROBE_TIMEOUT)
    line = ""
    for raw in result.out.splitlines():
        if raw.strip():
            line = raw.strip()
            break
    if result.code != 0 or not line:
        detail = one_line(result.err or result.out) or f"yt-dlp exited {result.code}"
        return Result("error", detail)
    parts = line.split("\t")
    while len(parts) < 3:
        parts.append("")
    return parts[0], parts[1], parts[2]


def opus_files(root: Path) -> set[Path]:
    if not root.exists():
        return set()
    return {path for path in root.rglob("*.opus") if path.is_file()}


def audio_episodes(root: Path) -> list[Path]:
    """Audio files in the output folder. Hidden names and symlinks are left out."""
    if not root.is_dir():
        return []
    found: list[Path] = []
    for path in root.rglob("*"):
        if not path.is_file() or path.is_symlink() or path.name.startswith("."):
            continue
        relative = path.relative_to(root)
        if any(part.startswith(".") for part in relative.parts):
            continue
        if path.suffix.lower() not in AUDIO_EXTENSIONS:
            continue
        found.append(path)
    return found


def episodes_past_keep(paths: list[Path], keep: int) -> list[Path]:
    """Oldest files once the newest `keep` are set aside. Oldest first."""
    ordered = sorted(paths, key=lambda path: (path.stat().st_mtime, path.name))
    if keep <= 0:
        return ordered
    if len(ordered) <= keep:
        return []
    return ordered[:-keep]


def clean_temp(temp: Path, max_age_days: int = 7) -> None:
    """Drop abandoned partial downloads. Fresh ones stay so yt-dlp can resume."""
    if not temp.exists():
        return
    cutoff = time.time() - max_age_days * 86400
    for path in temp.iterdir():
        try:
            if path.is_file() and path.stat().st_mtime < cutoff:
                path.unlink()
        except OSError:
            continue


def image_files(directory: Path) -> set[Path]:
    if not directory.exists():
        return set()
    return {
        path
        for path in directory.iterdir()
        if path.is_file() and path.suffix.lower() in {".jpg", ".jpeg", ".png", ".webp"}
    }


def jpeg_size(data: bytes) -> tuple[int, int]:
    """Width and height from a JPEG SOF marker. (0, 0) if it cannot be read."""
    index = 2
    while index + 9 < len(data):
        if data[index] != 0xFF:
            index += 1
            continue
        marker = data[index + 1]
        if marker in (0xC0, 0xC1, 0xC2):
            height = int.from_bytes(data[index + 5 : index + 7], "big")
            width = int.from_bytes(data[index + 7 : index + 9], "big")
            return width, height
        if marker in (0xD8, 0xD9):
            index += 2
            continue
        if index + 4 > len(data):
            break
        length = int.from_bytes(data[index + 2 : index + 4], "big")
        if length < 2:
            break
        index += 2 + length
    return 0, 0


def picture_block(jpeg: bytes) -> str:
    """Base64 FLAC picture block. Opus stores cover art in this comment."""
    width, height = jpeg_size(jpeg)
    mime = b"image/jpeg"
    description = b"Cover (front)"
    block = b"".join(
        [
            struct.pack(">I", 3),
            struct.pack(">I", len(mime)),
            mime,
            struct.pack(">I", len(description)),
            description,
            struct.pack(">I", width),
            struct.pack(">I", height),
            struct.pack(">I", 24),
            struct.pack(">I", 0),
            struct.pack(">I", len(jpeg)),
            jpeg,
        ]
    )
    return base64.b64encode(block).decode("ascii")


def ffmeta_escape(value: str) -> str:
    """Escape a value for an ffmetadata file. Base64 padding contains '='."""
    escaped = []
    for char in value:
        if char == "\n":
            escaped.append("\\n")
        elif char == "\r":
            escaped.append("\\r")
        elif char in "\\=;#":
            escaped.append("\\" + char)
        else:
            escaped.append(char)
    return "".join(escaped)


def embed_cover(audio: Path, image: Path) -> bool:
    """Attach a JPEG cover without re-encoding the audio.

    The Opus muxer cannot take a video stream. The cover goes in the
    METADATA_BLOCK_PICTURE comment, which is what players show for Grayjay files.
    The picture is written to a metadata file. One ffmpeg argument cannot
    exceed 128KiB, and a 1280x720 JPEG does.
    """
    jpeg_path = image
    converted = audio.with_name(audio.stem + ".cover.jpg")
    meta = audio.with_name(audio.stem + ".cover.ffmeta")
    temporary = audio.with_name(audio.stem + ".cover" + audio.suffix)
    try:
        if image.suffix.lower() not in {".jpg", ".jpeg"}:
            result = run_cmd(
                ["ffmpeg", "-y", "-hide_banner", "-loglevel", "error", "-i", str(image), str(converted)],
                60,
            )
            if result.code != 0 or not converted.is_file():
                log("cover art was not embedded (thumbnail was not a jpeg)")
                return False
            jpeg_path = converted
        encoded = picture_block(jpeg_path.read_bytes())
        meta.write_text(
            ";FFMETADATA1\nMETADATA_BLOCK_PICTURE=" + ffmeta_escape(encoded) + "\n",
            encoding="utf-8",
        )
        # Keep the tags yt-dlp wrote, and add the picture from the metadata file.
        result = run_cmd(
            [
                "ffmpeg",
                "-y",
                "-hide_banner",
                "-loglevel",
                "error",
                "-i",
                str(audio),
                "-i",
                str(meta),
                "-map",
                "0",
                "-c",
                "copy",
                "-map_metadata",
                "0",
                "-map_metadata",
                "1",
                str(temporary),
            ],
            180,
        )
    except OSError as exc:
        log(f"cover art was not embedded ({exc})")
        return False
    finally:
        if jpeg_path is converted:
            converted.unlink(missing_ok=True)
        meta.unlink(missing_ok=True)
    if result.code != 0 or not temporary.is_file() or temporary.stat().st_size == 0:
        temporary.unlink(missing_ok=True)
        detail = one_line(result.err or result.out)
        log("cover art was not embedded" + (f" ({detail})" if detail else ""))
        return False
    os.replace(temporary, audio)
    return True


def archive_video_id(url: str) -> str:
    """YouTube id as yt-dlp writes it in the download archive."""
    marked = youtube_id(url)
    if marked.startswith("yt:"):
        return marked[3:]
    return ""


def archive_has_id(text: str, video_id: str) -> bool:
    if not video_id:
        return False
    for line in text.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[-1] == video_id:
            return True
    return False


def archive_without_id(text: str, video_id: str) -> str:
    """Archive text with one video id removed. Every other line stays."""
    if not video_id:
        return text
    kept = []
    for line in text.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[-1] == video_id:
            continue
        kept.append(line)
    if not kept:
        return ""
    body = "\n".join(kept)
    if text.endswith("\n"):
        body += "\n"
    return body


def read_archive(path: Path) -> str:
    if not path.is_file():
        return ""
    return path.read_text(encoding="utf-8", errors="replace")


def forget_archived(path: Path, video_id: str) -> bool:
    """Drop one id from the yt-dlp archive. The rest of the file is kept."""
    text = read_archive(path)
    updated = archive_without_id(text, video_id)
    if updated == text:
        return False
    temporary = path.with_suffix(".txt.tmp")
    temporary.write_text(updated, encoding="utf-8")
    os.replace(temporary, path)
    return True


def missing_file_outcome(code: int, text: str, was_archived: bool, on_disk: bool) -> str:
    """What to do when yt-dlp wrote no new audio file.

    already: the video is already saved.
    refetch: the archive lists it, and the output folder does not have it.
    error: yt-dlp failed, or it finished without a file and without an archive hit.
    """
    said_archive = "already been recorded in the archive" in text
    said_exists = "has already been downloaded" in text
    if on_disk or said_exists:
        return "already"
    if code == 0 and (was_archived or said_archive):
        return "refetch"
    return "error"


def stem_has_video_id(stem: str, video_id: str) -> bool:
    """True when the id stands alone in the filename, as in 'Title [id]'."""
    if not video_id:
        return False
    folded = stem.casefold()
    needle = video_id.casefold()
    start = 0
    while True:
        index = folded.find(needle, start)
        if index < 0:
            return False
        end = index + len(needle)
        before = folded[index - 1] if index else ""
        after = folded[end] if end < len(folded) else ""
        if not before.isalnum() and not after.isalnum():
            return True
        start = index + 1


def audio_named_for(output_dir: Path, video_id: str, title: str) -> Path | None:
    """An existing audio file for this video, by id in the name or the Grayjay stem."""
    if not output_dir.is_dir():
        return None
    stem = ""
    if title and not title.startswith(("http://", "https://")):
        stem = grayjay_stem(title)
    for path in output_dir.rglob("*"):
        if not path.is_file() or path.name.startswith("."):
            continue
        if path.suffix.lower() not in AUDIO_EXTENSIONS:
            continue
        if stem and path.stem == stem:
            return path
        if stem_has_video_id(path.stem, video_id):
            return path
    return None


def download(
    url: str,
    cfg: dict[str, str],
    output_dir: Path,
    state_dir: Path,
    cookies: str,
    title: str = "",
    browser: str = "",
) -> Result:
    # Parts land outside output_dir so Syncthing does not pick up half a file.
    temp_dir = state_dir / "tmp"
    temp_dir.mkdir(parents=True, exist_ok=True)
    output_dir.mkdir(parents=True, exist_ok=True)
    filename = cfg["filename"]
    if "%(ext)s" not in filename:
        filename = filename + ".%(ext)s"
    want_cover = as_bool(cfg.get("embed_thumbnail", "true"))
    cmd = [
        "yt-dlp",
        "--no-simulate",
        "--no-playlist",
        "--no-progress",
        "-x",
        "-f",
        "bestaudio/best",
        "--audio-format",
        cfg["audio_format"],
        "--audio-quality",
        str(cfg["audio_quality"]),
        "--embed-metadata",
        "-o",
        filename,
        "-P",
        f"home:{output_dir}",
        "-P",
        f"temp:{temp_dir}",
        "-P",
        f"thumbnail:{temp_dir}",
        "--no-overwrites",
        "--download-archive",
        str(state_dir / "archive.txt"),
        "--print",
        "after_move:%(filepath)s",
    ]
    if want_cover:
        # Write the thumbnail beside the temp files. Cover art is attached
        # afterwards with ffmpeg, which does not need the mutagen module.
        cmd += ["--write-thumbnail", "--convert-thumbnails", "jpg"]
    if as_bool(cfg["windows_filenames"]):
        cmd.append("--windows-filenames")
    sponsorblock = cfg.get("sponsorblock", "").strip()
    if sponsorblock:
        cmd += ["--sponsorblock-remove", sponsorblock]
    cmd += yt_auth_args(cookies, browser)
    extra = cfg.get("extra_args", "").strip()
    if extra:
        cmd += shlex.split(extra)
    cmd.append(url)
    timeout = as_int(cfg["download_timeout_minutes"], "download_timeout_minutes") * 60
    archive_path = state_dir / "archive.txt"
    video_id = archive_video_id(url)
    # --print implies quiet, so an archive hit exits 0 and prints nothing.
    # A second pass runs only when that hit has no audio file left on disk.
    for attempt in (1, 2):
        was_archived = archive_has_id(read_archive(archive_path), video_id)
        before = opus_files(output_dir)
        images_before = image_files(temp_dir) if want_cover else set()
        result = run_cmd(cmd, timeout)
        text = result.out + "\n" + result.err
        printed = [line.strip() for line in result.out.splitlines() if line.strip()]
        wanted = "." + cfg["audio_format"].lower().lstrip(".")
        audio = [line for line in printed if Path(line).suffix.lower() == wanted and Path(line).is_file()]
        saved = audio[-1] if audio else ""
        if not saved:
            fresh = sorted(opus_files(output_dir) - before, key=lambda path: path.stat().st_mtime)
            if fresh:
                saved = str(fresh[-1])
        if saved:
            if want_cover:
                attach_cover(Path(saved), temp_dir, images_before)
            return Result("downloaded", "saved", saved)
        existing = audio_named_for(output_dir, video_id, title)
        outcome = missing_file_outcome(result.code, text, was_archived, existing is not None)
        if outcome == "already":
            return Result("downloaded", "already saved", str(existing) if existing else "")
        if outcome == "refetch" and attempt == 1:
            if not video_id:
                return Result("error", "the archive lists this video, but the audio file is missing")
            forget_archived(archive_path, video_id)
            log("archive listed this video, but the audio file is missing; downloading it again")
            continue
        detail = one_line(result.err or result.out)
        if not detail:
            if result.code == 0:
                detail = "yt-dlp finished without a file"
            else:
                detail = f"yt-dlp exited {result.code}"
        return Result("error", detail)
    return Result("error", "yt-dlp finished without a file")


def attach_cover(audio: Path, temp_dir: Path, images_before: set[Path]) -> None:
    fresh = sorted(image_files(temp_dir) - images_before, key=lambda path: path.stat().st_mtime)
    jpegs = [path for path in fresh if path.suffix.lower() in {".jpg", ".jpeg"}]
    chosen = (jpegs or fresh)[-1] if (jpegs or fresh) else None
    try:
        if chosen is None:
            log("cover art was not embedded (no thumbnail)")
        else:
            embed_cover(audio, chosen)
    except Exception as exc:
        log(f"cover art was not embedded ({one_line(str(exc))})")
    for picture in fresh:
        picture.unlink(missing_ok=True)


def process_entry(
    entry: Entry,
    state: dict,
    cfg: dict[str, str],
    output_dir: Path,
    state_dir: Path,
    cookies: str,
    seen: SeenTitles,
    now: datetime,
    dry_run: bool,
    browser: str = "",
) -> Result:
    prev = state["items"].get(entry.id)
    duplicate = seen.reason(entry.title)
    if duplicate:
        return Result("skipped", duplicate)
    probed = probe_live(entry.url, cookies, browser)
    if isinstance(probed, Result):
        return probed
    live_status, was_live, is_live = probed
    decision = classify(
        live_status,
        was_live,
        is_live,
        as_bool(cfg["skip_live"]),
        as_bool(cfg["skip_was_live"]),
    )
    if decision == "skip":
        return Result("skipped", f"livestream VOD ({live_status or 'was_live'})")
    if decision == "defer":
        give_up = as_int(cfg["live_give_up_days"], "live_give_up_days")
        if live_is_stale(entry, prev, now, give_up):
            return Result("skipped", f"livestream left alone after {give_up} days")
        return Result("deferred", live_status or "live")
    if dry_run:
        seen.add_title(entry.title)
        return Result("downloaded", "dry-run")
    saved = download(entry.url, cfg, output_dir, state_dir, cookies, entry.title, browser)
    if saved.status == "downloaded":
        seen.add_title(entry.title)
        if saved.detail == "saved" and saved.path:
            final = place_like_grayjay(Path(saved.path), entry.title)
            saved = Result(saved.status, saved.detail, str(final))
            seen.add_stem(final.stem)
        elif saved.path:
            # Already on disk. Remember the name, and do not rename that file.
            seen.add_stem(Path(saved.path).stem)
            saved = Result(saved.status, saved.detail, "")
    return saved


# --- logging and notifications ----------------------------------------------


LOG_PATH: Path | None = None


def log(message: str) -> None:
    print(message, flush=True)
    if LOG_PATH is None:
        return
    try:
        LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
        if LOG_PATH.exists() and LOG_PATH.stat().st_size > 1_000_000:
            os.replace(LOG_PATH, LOG_PATH.with_name("feedopus.log.1"))
        stamp = datetime.now().isoformat(timespec="seconds")
        with LOG_PATH.open("a", encoding="utf-8") as handle:
            handle.write(f"{stamp} {message}\n")
    except OSError:
        return


def notify(title: str, body: str, enabled: bool) -> None:
    if not enabled:
        return
    if shutil.which("notify-send"):
        subprocess.run(
            ["notify-send", "-a", "feedopus", title, body],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )
        return


def pause(seconds: int) -> None:
    if seconds > 0:
        time.sleep(seconds)


