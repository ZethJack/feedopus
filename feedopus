def resolve_dirs(args: argparse.Namespace) -> tuple[Path, Path]:
    config_dir = Path(args.config_dir).expanduser() if args.config_dir else default_config_dir()
    state_dir = Path(args.state_dir).expanduser() if args.state_dir else default_state_dir()
    return config_dir, state_dir


def cmd_init(config_dir: Path, force: bool = False) -> int:
    config_dir.mkdir(parents=True, exist_ok=True)
    feeds_file = config_dir / "feeds"
    config_file = config_dir / "config"
    if config_file.exists() and not force:
        log(f"config already exists: {pretty(str(config_file))}")
    else:
        config_file.write_text(config_text(feeds_file), encoding="utf-8")
        log(f"wrote {pretty(str(config_file))}")
    if feeds_file.exists() and not force:
        log(f"feed list already exists: {pretty(str(feeds_file))}")
        return 0
    newsboat = Path.home() / ".config" / "newsboat" / "urls"
    imported = import_newsboat(newsboat)
    header = [
        "# Feeds and subscriptions to save as audio.",
        "# One URL per line. Optional quoted name, then optional tags:",
        '#   https://www.youtube.com/feeds/videos.xml?channel_id=UC... "Name"',
        "#   https://www.youtube.com/@Channel \"Name\"",
        "# YouTube feeds/videos.xml is read as RSS. If that fails, the uploads playlist is checked.",
        "# Other RSS/Atom URLs are read directly. Any other URL is a channel or playlist.",
        "# Imported video feeds from newsboat. Blogs and distro news were left out.",
        "",
    ]
    body = imported or [
        "# https://www.youtube.com/feeds/videos.xml?channel_id=CHANNEL_ID \"Channel name\""
    ]
    feeds_file.write_text("\n".join(header + body) + "\n", encoding="utf-8")
    log(f"wrote {pretty(str(feeds_file))} ({len(imported)} feeds)")
    if not imported:
        log("no video feeds were found in newsboat. Add URLs to the feed list.")
        return 1
    return 0


def checked_output(cfg: dict[str, str], override: str | None) -> Path:
    raw = override or cfg.get("output_dir") or ""
    if not raw or raw.strip() == "auto":
        path = default_output_dir()
    else:
        path = Path(expand(raw))
    resolved = path.expanduser().resolve()
    if resolved == Path.home().resolve() or resolved == Path("/"):
        raise SystemExit(f"refusing to use {resolved} as output_dir")
    return resolved


def checked_cookies(cfg: dict[str, str]) -> str:
    raw = cfg.get("cookies", "").strip()
    if not raw:
        return ""
    path = Path(expand(raw))
    if not path.is_file():
        log(f"cookies file not found, ignoring: {path}")
        return ""
    return str(path)


def browser_cookies(cfg: dict[str, str]) -> str:
    return cfg.get("cookies_from_browser", "").strip()


def yt_auth_args(cookies: str, browser: str) -> list[str]:
    # A browser session is fresher than a saved cookie file. Pass only one.
    if browser:
        return ["--cookies-from-browser", browser]
    if cookies:
        return ["--cookies", cookies]
    return []


def acquire_lock(state_dir: Path):
    state_dir.mkdir(parents=True, exist_ok=True)
    handle = (state_dir / "feedopus.lock").open("a+")
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.close()
        log("feedopus is already running")
        return None
    return handle


def cmd_clean(args: argparse.Namespace, config_dir: Path, state_dir: Path) -> int:
    """Delete the oldest audio files, leaving the newest keep_episodes."""
    cfg = load_config(config_dir / "config")
    output_dir = checked_output(cfg, args.output_dir)
    keep = args.keep if args.keep is not None else as_int(cfg.get("keep_episodes", "30"), "keep_episodes")
    if keep < 0:
        raise SystemExit("--keep must be 0 or more")
    lock = acquire_lock(state_dir)
    if lock is None:
        return 0
    try:
        if not output_dir.is_dir():
            log(f"no output folder at {pretty(str(output_dir))}")
            return 0
        episodes = audio_episodes(output_dir)
        doomed = episodes_past_keep(episodes, keep)
        verb = "would remove" if args.dry_run else "removed"
        for path in doomed:
            if not args.dry_run:
                path.unlink()
            log(f"{verb:12} {pretty(str(path))}")
        log(f"kept {len(episodes) - len(doomed)}, {verb} {len(doomed)}")
        return 0
    finally:
        lock.close()


