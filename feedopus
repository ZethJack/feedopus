HELP_EXAMPLES = """
examples:
  feedopus                     check feeds and download
  feedopus run --dry-run       show decisions without saving
  feedopus run --backfill 3    take the 3 newest unsaved items per feed
  feedopus grab URL            save one video
  feedopus init                write config and import newsboat video feeds
  feedopus list                show the selected feeds
  feedopus status              show what has been remembered
  feedopus clean --dry-run     show the oldest episodes that clean would delete
  feedopus clean --keep 30     delete older audio, leaving the 30 newest files
  feedopus install-timer       check about every two hours on Linux

files:
  ~/.config/feedopus/config    settings (output folder, since_days, thumbnails)
  ~/.config/feedopus/feeds     one URL per line
  ~/Sync/podcast               finished audio

man feedopus explains each setting. tldr feedopus shows these examples.
Run feedopus install-docs if either of those is missing.
"""


def build_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument(
        "--config-dir",
        metavar="DIR",
        help="directory with config and the feed list (default: ~/.config/feedopus)",
    )
    common.add_argument(
        "--state-dir",
        metavar="DIR",
        help="directory for the seen-item database and logs (default: ~/.local/state/feedopus)",
    )

    parser = argparse.ArgumentParser(
        prog="feedopus",
        description=(
            "Save new videos from selected feeds as Opus audio. "
            "Livestreams and stream VODs are skipped."
        ),
        epilog=HELP_EXAMPLES,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="cmd", metavar="command")

    run = sub.add_parser(
        "run",
        parents=[common],
        help="check feeds and download new audio (the default)",
        description=(
            "Check the feed list and save new uploads as Opus audio. "
            "feedopus with no command does this."
        ),
        epilog=HELP_EXAMPLES,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    run.add_argument("--dry-run", action="store_true", help="print decisions without saving files or state")
    run.add_argument(
        "--since-days",
        type=int,
        metavar="N",
        help="only items newer than N days. The first visit uses since_days (2) and remembers older items",
    )
    run.add_argument(
        "--backfill",
        type=int,
        metavar="N",
        help="save the N newest unsaved items in each feed and mark the rest seen",
    )
    run.add_argument(
        "--max",
        dest="max_per_run",
        type=int,
        metavar="N",
        help="stop after N download attempts (default: max_per_run, 8)",
    )
    run.add_argument("--retry", action="store_true", help="try items that already failed three times")
    run.add_argument("--output-dir", metavar="DIR", help="write finished audio here instead of output_dir")

    grab = sub.add_parser(
        "grab",
        parents=[common],
        help="save one video URL as audio",
        description="Save one video URL as Opus audio, using the same settings as a feed run.",
    )
    grab.add_argument("url", help="video page to save")
    grab.add_argument("--dry-run", action="store_true", help="print the decision without saving")
    grab.add_argument("--output-dir", metavar="DIR", help="write the file here instead of output_dir")

    init = sub.add_parser("init", parents=[common], help="write config and import newsboat video feeds")
    init.add_argument("--force", action="store_true", help="overwrite an existing config and feed list")

    sub.add_parser("list", parents=[common], help="show the selected feeds")
    sub.add_parser("status", parents=[common], help="show remembered items")
    clean = sub.add_parser(
        "clean",
        parents=[common],
        help="delete the oldest audio files in the output folder",
        description=(
            "Delete the oldest audio files in the output folder, leaving the newest ones. "
            "Remembered episodes stay remembered, so a removed file is not downloaded again."
        ),
    )
    clean.add_argument("--dry-run", action="store_true", help="print the files that would be deleted")
    clean.add_argument(
        "--keep",
        type=int,
        metavar="N",
        help="leave this many newest episodes (default: keep_episodes, 30)",
    )
    clean.add_argument("--output-dir", metavar="DIR", help="clean this folder instead of output_dir")
    sub.add_parser("install-timer", help="enable a systemd user timer that checks about every two hours")
    sub.add_parser("remove-timer", help="disable and remove the systemd user timer")
    sub.add_parser("install-docs", help="install the manual page and the tldr page")
    sub.add_parser("self-test", help="run offline checks")
    return parser


def main(argv: list[str]) -> int:
    if not argv or (argv[0].startswith("-") and argv[0] not in {"-h", "--help"}):
        argv = ["run", *argv]
    parser = build_parser()
    args = parser.parse_args(argv)
    config_dir, state_dir = (None, None)
    if hasattr(args, "config_dir"):
        config_dir, state_dir = resolve_dirs(args)
    if args.cmd == "run":
        return cmd_run(args, config_dir, state_dir)
    if args.cmd == "grab":
        return cmd_grab(args, config_dir, state_dir)
    if args.cmd == "init":
        return cmd_init(config_dir, args.force)
    if args.cmd == "list":
        return cmd_list(config_dir)
    if args.cmd == "status":
        return cmd_status(state_dir)
    if args.cmd == "clean":
        return cmd_clean(args, config_dir, state_dir)
    if args.cmd == "install-timer":
        return cmd_install_timer()
    if args.cmd == "remove-timer":
        return cmd_remove_timer()
    if args.cmd == "install-docs":
        return cmd_install_docs()
    if args.cmd == "self-test":
        return cmd_self_test()
    parser.print_help()
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print("\ninterrupted", flush=True)
        sys.exit(130)
