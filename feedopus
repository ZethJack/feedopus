def cmd_status(state_dir: Path) -> int:
    state = load_state(state_dir / "state.json")
    counts: dict[str, int] = {}
    for item in state["items"].values():
        status = str(item.get("status") or "unknown")
        counts[status] = counts.get(status, 0) + 1
    feeds = state.get("feeds", {})
    ready = sum(1 for feed in feeds.values() if feed.get("bootstrapped"))
    print(f"feeds remembered: {len(feeds)} ({ready} already caught up)")
    if not counts:
        print("no items remembered yet")
        return 0
    for status in ("downloaded", "skipped", "seen", "deferred", "error"):
        if counts.get(status):
            print(f"{status}: {counts[status]}")
    errors = [item for item in state["items"].values() if item.get("status") == "error"]
    for item in errors[-10:]:
        print(f"  error  {one_line(str(item.get('title') or item.get('url')))} ({one_line(str(item.get('detail') or ''))})")
    return 0


def cmd_grab(args: argparse.Namespace, config_dir: Path, state_dir: Path) -> int:
    global LOG_PATH
    require_tools()
    cfg = load_config(config_dir / "config")
    if not (config_dir / "config").exists():
        log("no config yet. Run: feedopus init")
    output_dir = checked_output(cfg, args.output_dir)
    LOG_PATH = state_dir / "feedopus.log"
    cookies = checked_cookies(cfg)
    browser = browser_cookies(cfg)
    lock = acquire_lock(state_dir)
    if lock is None:
        return 0
    try:
        state = load_state(state_dir / "state.json")
        entry_id = youtube_id(args.url) or args.url
        entry = Entry(
            id=entry_id,
            url=args.url,
            title=args.url,
            author="",
            published=datetime.now(timezone.utc),
            feed_url="",
            feed_name="grab",
        )
        now = datetime.now(timezone.utc)
        seen = load_seen(state, output_dir)
        result = process_entry(
            entry, state, cfg, output_dir, state_dir, cookies, seen, now, args.dry_run, browser
        )
        if result.status == "downloaded" and not args.dry_run:
            # The feed title was the URL. Keep yt-dlp's filename, and store the URL title
            # only when we learned nothing better. Probe does not return the title.
            record(state, entry, result, state["items"].get(entry.id), now)
            save_state(state_dir / "state.json", state)
            where = pretty(result.path) or output_dir
            log(f"saved     {where}")
        elif args.dry_run and result.status == "downloaded":
            log(f"would save {args.url}")
        else:
            if not args.dry_run:
                record(state, entry, result, state["items"].get(entry.id), now)
                save_state(state_dir / "state.json", state)
            log(f"{result.status:<10} {args.url} ({result.detail})")
        return 0 if result.status != "error" else 1
    finally:
        lock.close()


def cmd_run(args: argparse.Namespace, config_dir: Path, state_dir: Path) -> int:
    global LOG_PATH
    config_file = config_dir / "config"
    if not config_file.exists():
        log("creating a first-time config from newsboat")
        cmd_init(config_dir)
    cfg = load_config(config_file)
    feeds_file = feeds_path_from(cfg, config_dir)
    if not feeds_file.exists():
        raise SystemExit(f"no feed list at {feeds_file}. Run: feedopus init")
    require_tools()
    output_dir = checked_output(cfg, args.output_dir)
    LOG_PATH = state_dir / "feedopus.log"
    cookies = checked_cookies(cfg)
    browser = browser_cookies(cfg)
    feeds = load_feeds(feeds_file, cfg.get("require_tag", "").strip())
    if not feeds:
        raise SystemExit(f"no feeds selected in {feeds_file}")
    lock = acquire_lock(state_dir)
    if lock is None:
        return 0
    clean_temp(state_dir / "tmp")
    try:
        return run_locked(args, cfg, feeds, output_dir, state_dir, cookies, browser)
    finally:
        lock.close()


def run_locked(
    args: argparse.Namespace,
    cfg: dict[str, str],
    feeds: list[Feed],
    output_dir: Path,
    state_dir: Path,
    cookies: str,
    browser: str = "",
) -> int:
    state_path = state_dir / "state.json"
    state = load_state(state_path)
    now = datetime.now(timezone.utc)
    since_days = args.since_days if args.since_days is not None else as_int(cfg["since_days"], "since_days")
    if since_days < 0:
        raise SystemExit("--since-days must be 0 or more")
    explicit = args.since_days is not None
    backfill = args.backfill
    if backfill is not None and backfill < 1:
        raise SystemExit("--backfill must be 1 or more")
    max_per_run = args.max_per_run if args.max_per_run is not None else as_int(cfg["max_per_run"], "max_per_run")
    if max_per_run < 1:
        raise SystemExit("--max must be 1 or more")
    sleep_seconds = as_int(cfg["sleep_seconds"], "sleep_seconds")
    playlist_end = as_int(cfg["playlist_end"], "playlist_end")
    seen = load_seen(state, output_dir)
    groups: list[list[Entry]] = []
    feeds_ok = 0
    feeds_failed = 0
    undated_first = False

    for feed in feeds:
        info = state["feeds"].get(feed.url) or {}
        bootstrapped = bool(info.get("bootstrapped"))
        try:
            entries = fetch_feed(feed, playlist_end, cookies, browser)
        except (urllib.error.URLError, TimeoutError, OSError, RuntimeError, ET.ParseError, ValueError) as exc:
            feeds_failed += 1
            log(f"error     {feed.name or feed.url} ({one_line(str(exc))})")
            if not args.dry_run:
                info = dict(info)
                info["last_error"] = one_line(str(exc))
                info["name"] = feed.name
                state["feeds"][feed.url] = info
                save_state(state_path, state)
            continue
        feeds_ok += 1
        actions = plan_feed(
            entries,
            state["items"],
            bootstrapped,
            since_days,
            explicit,
            backfill,
            args.retry,
            now,
        )
        queued: list[Entry] = []
        seen_count = 0
        undated = 0
        for action in actions:
            if action[0] == "queue":
                queued.append(action[1])
            else:
                seen_count += 1
                if action[2] == "undated on first fetch":
                    undated += 1
                if not args.dry_run:
                    record(state, action[1], Result("seen", action[2]), state["items"].get(action[1].id), now)
        if not args.dry_run:
            state["feeds"][feed.url] = {
                "bootstrapped": True,
                "name": feed.name or (entries[0].feed_name if entries else ""),
                "last_ok": now.isoformat(),
                "last_error": "",
            }
            save_state(state_path, state)
        name = feed.name or (entries[0].feed_name if entries else feed.url)
        if queued or not bootstrapped:
            extra = ""
            if undated and not bootstrapped:
                undated_first = True
                extra = ". No dates on the first fetch; use --backfill N for the newest"
            log(f"{name}: {len(queued)} to check, {seen_count} left alone{extra}")
        groups.append(queued)

    if feeds_ok == 0:
        log("every feed failed")
        notify("feedopus", "Every feed failed. See the log.", as_bool(cfg["notify"]))
        return 1

    ordered = round_robin(groups)
    saved: list[str] = []
    skipped = 0
    deferred = 0
    errors = 0
    attempts = 0
    calls = 0
    for entry in ordered:
        if attempts >= max_per_run:
            break
        if calls:
            pause(sleep_seconds)
        calls += 1
        result = process_entry(
            entry,
            state,
            cfg,
            output_dir,
            state_dir,
            cookies,
            seen,
            now,
            args.dry_run,
            browser,
        )
        if result.status in {"downloaded", "error"} and result.detail != "dry-run":
            attempts += 1
        if result.detail == "dry-run" and result.status == "downloaded":
            attempts += 1
            saved.append(label(entry))
            log(f"would save {label(entry)}")
            continue
        if not args.dry_run:
            record(state, entry, result, state["items"].get(entry.id), now)
            save_state(state_path, state)
        if result.status == "downloaded":
            where = pretty(result.path)
            suffix = f" -> {where}" if where else ""
            log(f"saved     {label(entry)}{suffix}")
            saved.append(label(entry) + (f"\n{where}" if where else ""))
        elif result.status == "skipped":
            skipped += 1
            log(f"skip      {label(entry)} ({result.detail})")
        elif result.status == "deferred":
            deferred += 1
            log(f"defer     {label(entry)} ({result.detail})")
        else:
            errors += 1
            log(f"error     {label(entry)} ({result.detail})")

    if not ordered:
        log("nothing new")
    else:
        verb = "would save" if args.dry_run else "saved"
        log(
            f"{verb} {len(saved)}, skipped {skipped}, "
            f"still live {deferred}, errors {errors}"
        )
    if undated_first and backfill is None:
        log("some feeds had no dates. feedopus run --backfill 3 grabs the three newest from each")
    if not args.dry_run and (saved or errors):
        if saved:
            body = f"Saved {len(saved)} audio file" + ("" if len(saved) == 1 else "s")
            shown = "\n".join(item.split("\n", 1)[0] for item in saved[:5])
            notify("feedopus", body + "\n" + shown, as_bool(cfg["notify"]))
        elif errors:
            notify("feedopus", f"{errors} download" + ("s" if errors != 1 else "") + " failed", as_bool(cfg["notify"]))
    return 0


