def cmd_install_docs() -> int:
    """Copy the manual and the tldr page into the per-user locations."""
    root = Path(__file__).resolve().parent
    man_src = root / "feedopus.1"
    tldr_src = root / "tldr" / "pages" / "common" / "feedopus.md"
    fish_src = root / "fish" / "tldr.fish"
    missing = [str(path) for path in (man_src, tldr_src, fish_src) if not path.is_file()]
    if missing:
        raise SystemExit(
            "documentation files missing next to feedopus: "
            + ", ".join(missing)
            + ". Run ./install-linux from the unpacked source tree."
        )

    man_dir = Path.home() / ".local" / "share" / "man" / "man1"
    man_dir.mkdir(parents=True, exist_ok=True)
    (man_dir / "feedopus.1").write_bytes(man_src.read_bytes())

    data_home = os.environ.get("XDG_DATA_HOME", "").strip()
    data_base = Path(data_home) if data_home else Path.home() / ".local" / "share"
    cache_home = os.environ.get("XDG_CACHE_HOME", "").strip()
    cache_base = Path(cache_home) if cache_home else Path.home() / ".cache"
    page = tldr_src.read_bytes()
    for base in (data_base, cache_base):
        dest_dir = base / "tldr" / "pages" / "common"
        dest_dir.mkdir(parents=True, exist_ok=True)
        (dest_dir / "feedopus.md").write_bytes(page)

    functions = Path.home() / ".config" / "fish" / "functions"
    fish_dest = functions / "tldr.fish"
    if functions.is_dir():
        current = fish_dest.read_text(encoding="utf-8") if fish_dest.is_file() else ""
        if fish_dest.is_file() and "feedopus-tldr-wrapper" not in current:
            log(f"left the existing fish function in place: {fish_dest}")
        else:
            fish_dest.write_bytes(fish_src.read_bytes())
    log("installed man feedopus and tldr feedopus")
    return 0


def cmd_install_timer() -> int:
    if not shutil.which("systemctl"):
        raise SystemExit("systemctl is not available.")
    executable = Path("~/.local/bin/feedopus").expanduser()
    if not os.access(executable, os.X_OK):
        executable = Path(__file__).resolve()
    unit_dir = Path.home() / ".config" / "systemd" / "user"
    unit_dir.mkdir(parents=True, exist_ok=True)
    (unit_dir / "feedopus.service").write_text(service_unit(str(executable)), encoding="utf-8")
    (unit_dir / "feedopus.timer").write_text(TIMER_UNIT, encoding="utf-8")
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
    enabled = subprocess.run(["systemctl", "--user", "enable", "feedopus.timer"], check=False)
    if enabled.returncode != 0:
        raise SystemExit("could not enable feedopus.timer")
    # Do not start the timer here. Persistent=true can run one missed slot as
    # soon as the timer starts, which would begin a download immediately.
    log("enabled feedopus.timer. Start it with: systemctl --user start feedopus.timer")
    log("It checks about every two hours, at :20 past even hours.")
    return 0


def cmd_remove_timer() -> int:
    subprocess.run(["systemctl", "--user", "disable", "--now", "feedopus.timer"], check=False)
    unit_dir = Path.home() / ".config" / "systemd" / "user"
    for name in ("feedopus.timer", "feedopus.service"):
        path = unit_dir / name
        if path.exists():
            path.unlink()
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
    log("removed feedopus.timer")
    return 0


